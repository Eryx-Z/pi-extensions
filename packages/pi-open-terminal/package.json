{
  "name": "pi-open-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open a new Kitty terminal in Pi's current working directory with /d",
  "keywords": [
    "pi-package",
    "pi-extension",
    "terminal",
    "kitty"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
